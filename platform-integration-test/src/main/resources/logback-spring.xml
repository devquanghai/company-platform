<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Application owns Logback bootstrap; platform-logging supplies reusable fragments. -->
    <springProfile name="default | local">
        <include resource="com/company/platform/logging/logback/defaults.xml"/>
        <include resource="com/company/platform/logging/logback/console-highlight-appender.xml"/>
        <include resource="com/company/platform/logging/logback/audit-appender.xml"/>
        <include resource="com/company/platform/logging/logback/platform-loggers.xml"/>
        <root level="${ROOT_LOG_LEVEL:-INFO}">
            <appender-ref ref="PLATFORM_CONSOLE_HIGHLIGHT"/>
        </root>
    </springProfile>

    <springProfile name="sit">
        <include resource="com/company/platform/logging/logback/defaults.xml"/>
        <include resource="com/company/platform/logging/logback/console-highlight-appender.xml"/>
        <include resource="com/company/platform/logging/logback/audit-appender.xml"/>
        <include resource="com/company/platform/logging/logback/platform-loggers.xml"/>
        <root level="${ROOT_LOG_LEVEL:-INFO}">
            <appender-ref ref="PLATFORM_CONSOLE_HIGHLIGHT"/>
        </root>
    </springProfile>

    <springProfile name="uat">
        <include resource="com/company/platform/logging/logback/defaults.xml"/>
        <include resource="com/company/platform/logging/logback/console-json-appender.xml"/>
        <include resource="com/company/platform/logging/logback/audit-appender.xml"/>
        <include resource="com/company/platform/logging/logback/platform-loggers.xml"/>
        <root level="${ROOT_LOG_LEVEL:-INFO}">
            <appender-ref ref="PLATFORM_CONSOLE_JSON"/>
        </root>
    </springProfile>

    <springProfile name="prod">
        <include resource="com/company/platform/logging/logback/defaults.xml"/>
        <include resource="com/company/platform/logging/logback/console-json-appender.xml"/>
        <include resource="com/company/platform/logging/logback/audit-appender.xml"/>
        <include resource="com/company/platform/logging/logback/platform-loggers.xml"/>
        <property name="PLATFORM_ASYNC_DELEGATE" value="PLATFORM_CONSOLE_JSON"/>
        <include resource="com/company/platform/logging/logback/async-appender.xml"/>
        <root level="${ROOT_LOG_LEVEL:-INFO}">
            <appender-ref ref="PLATFORM_ASYNC"/>
        </root>
    </springProfile>
</configuration>
