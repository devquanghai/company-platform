<?xml version="1.0" encoding="UTF-8"?>
<included>
    <property name="PLATFORM_TEXT_PATTERN"
              value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %5p [%thread] [%X{traceId:-}] [%X{requestId:-}] %logger{36} - %maskedMsg %maskedKv %maskedMdc%n%safeEx"/>
    <property name="PLATFORM_STRUCTURED_FORMAT" value="${PLATFORM_STRUCTURED_FORMAT:-ecs}"/>
    <conversionRule conversionWord="maskedMsg"
                    class="com.company.platform.logging.logback.converter.MaskingMessageConverter"/>
    <conversionRule conversionWord="maskedKv"
                    class="com.company.platform.logging.logback.converter.MaskingKeyValueConverter"/>
    <conversionRule conversionWord="maskedMdc"
                    class="com.company.platform.logging.logback.converter.MaskingMdcConverter"/>
    <conversionRule conversionWord="safeEx"
                    class="com.company.platform.logging.logback.converter.SanitizedThrowableProxyConverter"/>
</included>
