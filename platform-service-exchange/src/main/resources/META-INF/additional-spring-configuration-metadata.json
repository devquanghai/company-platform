{
  "groups": [
    {
      "name": "platform.service-exchange.clients",
      "type": "java.util.Map",
      "description": "Named outbound clients; map keys are stable client identities."
    }
  ],
  "properties": [
    { "name": "platform.service-exchange.clients.*.enabled", "type": "java.lang.Boolean", "defaultValue": true },
    { "name": "platform.service-exchange.clients.*.type", "type": "com.company.platform.exchange.api.client.ServiceExchangeClientType", "defaultValue": "WEBCLIENT" },
    { "name": "platform.service-exchange.clients.*.base-url", "type": "java.lang.String" },
    { "name": "platform.service-exchange.clients.*.grpc-channel", "type": "java.lang.String" },
    { "name": "platform.service-exchange.clients.*.resilience-instance", "type": "java.lang.String" },
    { "name": "platform.service-exchange.clients.*.ssl-bundle", "type": "java.lang.String" },
    { "name": "platform.service-exchange.clients.*.resilience-enabled", "type": "java.lang.Boolean", "defaultValue": true },
    { "name": "platform.service-exchange.clients.*.observability-enabled", "type": "java.lang.Boolean", "defaultValue": true },
    { "name": "platform.service-exchange.clients.*.logging.enabled", "type": "java.lang.Boolean", "defaultValue": true },
    { "name": "platform.service-exchange.clients.*.logging.curl-enabled", "type": "java.lang.Boolean", "defaultValue": false },
    { "name": "platform.service-exchange.clients.*.logging.request-headers-enabled", "type": "java.lang.Boolean", "defaultValue": true },
    { "name": "platform.service-exchange.clients.*.logging.request-body-enabled", "type": "java.lang.Boolean", "defaultValue": false },
    { "name": "platform.service-exchange.clients.*.logging.max-body-length", "type": "java.lang.Integer", "defaultValue": 4096, "description": "Deprecated compatibility property; log bodies are never partially truncated.", "deprecation": { "level": "warning", "reason": "Body output now uses a hard whole-value safety omission policy." } },
    { "name": "platform.service-exchange.clients.*.audit.enabled", "type": "java.lang.Boolean", "defaultValue": true },
    { "name": "platform.service-exchange.clients.*.audit.publish-attempt-events", "type": "java.lang.Boolean", "defaultValue": false },
    { "name": "platform.service-exchange.clients.*.audit.failure-mode", "type": "com.company.platform.exchange.autoconfigure.properties.AuditFailureMode", "defaultValue": "FAIL_OPEN" }
  ]
}
